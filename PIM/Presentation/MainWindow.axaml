<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PIM.MainWindow"
        Title="PIM">
        
    <Grid ColumnDefinitions="160,*">
        
        <!--Left Side of Grid: --> 
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="3"></Border>
        <StackPanel Grid.Column="0" Margin="10" Spacing="10" >
            <Button Name="PIT" Width="140" Click="PITButton"> PIT </Button>
            <Button Name="DPIT" Width="140" Click="DPITButton"> DPIT </Button>
            <Button Name="ChangeLog" Width="140" Click="ChangeLogButton"> Change Log</Button>
        </StackPanel>
            
        <!--Right Side of Grid: -->
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="3"></Border>
        <ContentControl Grid.Column="1" x:Name="MainContent"/>
            
    </Grid>
    
</Window>