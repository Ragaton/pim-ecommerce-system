<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:PIM"
             xmlns:services="using:PIM.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PIM.ChangeLog"
             x:DataType="local:ChangeLog">
    
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Top: Title -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="3">
            <TextBlock Margin="10" FontSize="20" FontWeight="Bold" Text="Change Log"/>
        </Border>

        <!-- Middle: Filter bar -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="3">
            <Grid Margin="5" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="5,0,10,0" Text="Filter by operation:"/>
                <ComboBox Grid.Column="1"
                          Name="FilterBox"
                          SelectionChanged="OnFilterChanged"
                          SelectedIndex="0">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="CREATE"/>
                    <ComboBoxItem Content="UPDATE"/>
                    <ComboBoxItem Content="DELETE"/>
                    <ComboBoxItem Content="STATUS CHANGE"/>
                </ComboBox>
                <Button Grid.Column="2" Margin="10,0,0,0" Click="OnRefreshClick">Refresh</Button>
            </Grid>
        </Border>

        <!-- Bottom: Table -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="3">
            <DataGrid Name="ChangeLogGrid"
                      ItemsSource="{Binding Entries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp"  Binding="{Binding Timestamp,     DataType=services:ChangeLogEntry}" Width="180"/>
                    <DataGridTextColumn Header="Operation"  Binding="{Binding OperationType, DataType=services:ChangeLogEntry}" Width="160"/>
                    <DataGridTextColumn Header="Before"     Binding="{Binding Before,        DataType=services:ChangeLogEntry}" Width="*"/>
                    <DataGridTextColumn Header="After"      Binding="{Binding After,         DataType=services:ChangeLogEntry}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
