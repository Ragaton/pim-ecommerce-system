<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PIM.Presentation.EditProductPage">

    <Border BorderBrush="Gray" BorderThickness="3">
        <ScrollViewer>
            <StackPanel Margin="20" Spacing="8">
                <TextBlock Text="Edit Product" FontSize="24"/>

                <!-- Step 1: Variant ID lookup -->
                <TextBlock Text="Variant ID"/>
                <TextBox x:Name="VariantIdBox" Watermark="e.g. 42"/>
                <Button Content="Load Product" Click="OnLoadClick"/>
                <TextBlock x:Name="StatusText" Foreground="Gray"/>

                <!-- Step 2: Form, hidden until a product is loaded -->
                <StackPanel x:Name="FormPanel" IsVisible="False" Spacing="8">

                    <TextBlock Text="Product Name"/>
                    <TextBox x:Name="ProductNameBox"/>

                    <TextBlock Text="Category"/>
                    <ComboBox x:Name="CategoryBox" Width="300" SelectionChanged="OnCategoryChanged"/>

                    <TextBlock Text="SKU"/>
                    <TextBox x:Name="SkuBox"/>

                    <TextBlock Text="Price"/>
                    <TextBox x:Name="PriceBox"/>

                    <TextBlock Text="Base Price"/>
                    <TextBox x:Name="BasePriceBox"/>

                    <TextBlock Text="Cost Price"/>
                    <TextBox x:Name="CostPriceBox"/>

                    <TextBlock Text="Attributes" FontSize="16"/>
                    <StackPanel x:Name="AttributesPanel" Spacing="8"/>

                    <Button Content="Save Changes" Click="OnSaveClick"/>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>

</UserControl>