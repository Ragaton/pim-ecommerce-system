<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PIM.CreateProductPage">

    <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="3">
        <ScrollViewer>
            <StackPanel Margin="20" Spacing="8">
                <TextBlock Text="Create Product" FontSize="24"/>

                <TextBlock Text="Product Name"/>
                <TextBox x:Name="ProductNameBox" Watermark="e.g. iPhone 15"/>

                <TextBlock Text="Category"/>
                <ComboBox x:Name="CategoryBox" Width="200" SelectionChanged="OnCategoryChanged">
                    <ComboBoxItem Content="Phones"/>
                    <ComboBoxItem Content="PCs"/>
                    <ComboBoxItem Content="Keyboards"/>
                </ComboBox>

                <TextBlock Text="SKU"/>
                <TextBox x:Name="SkuBox" Watermark="e.g. IP15-128-BLK"/>

                <TextBlock Text="Price"/>
                <TextBox x:Name="PriceBox" Watermark="e.g. 799.00"/>

                <TextBlock Text="Base Price"/>
                <TextBox x:Name="BasePriceBox" Watermark="e.g. 750.00"/>

                <TextBlock Text="Cost Price"/>
                <TextBox x:Name="CostPriceBox" Watermark="e.g. 600.00"/>

                <TextBlock Text="Attributes" FontSize="16"/>

                <!-- Attribute fields will be added here dynamically -->
                <StackPanel x:Name="AttributesPanel" Spacing="8"/>

                <Button Content="Save Product" Click="OnSaveClick"/>

                <TextBlock x:Name="StatusText" Foreground="Gray"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
    
</UserControl>